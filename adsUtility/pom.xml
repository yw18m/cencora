<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <artifactId>externalLibrary</artifactId>
        <groupId>com.cencora</groupId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <groupId>com.cencora</groupId>
    <artifactId>adsUtility</artifactId>
    <version>1.0-SNAPSHOT</version>

    <name>External Library template</name>
    <description>External Library template
    </description>
    <properties>
        <ads-mojo.version>14.1.10</ads-mojo.version>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>com.ibm.decision</groupId>
                    <artifactId>build-maven-plugin</artifactId>
                    <version>${ads-mojo.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>com.ibm.decision</groupId>
                <artifactId>build-maven-plugin</artifactId>
                <version>${ads-mojo.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>export</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <deployments>
                        <deployment>
                            <name>${project.artifactId}</name>
                        </deployment>
                    </deployments>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.ibm.decision</groupId>
                <artifactId>import-maven-plugin</artifactId>
                <version>${ads-mojo.version}</version>
                <executions>
                    <execution>
                        <id>generate-external-annotations-BOM-Voc</id>
                        <phase>generate-sources</phase>
                        <configuration>
                            <skip>false</skip>
                            <locales>
                                <locale>en_US</locale>
                            </locales>
                            <importMethods>true</importMethods>
                            <filter>
                                <includes>
                                    <include>com.cencora.DroolsUtility</include>
                                    <include>com.cencora.RuleEngineRequest</include>
                                    <include>com.jayway.jsonpath.DocumentContext</include>
                                </includes>
                                <excludes>
                                    <exclude>**</exclude>
                                </excludes>
                            </filter>
                            <referenceFolder>reference</referenceFolder>
                        </configuration>
                        <goals>
                            <goal>import</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>com.cencora</groupId>
            <artifactId>droolLibrary</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
    </dependencies>
</project>